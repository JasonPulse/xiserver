= 🤖 Puppetmaster — Gear Guide =

{{html clean="false"}}
<style>
.gt { width:100%; border-collapse:collapse; margin:8px 0 24px; font-size:14px; }
.gt th { background:#2a3540; color:#fff; padding:10px 12px; text-align:left; border:1px solid #555; font-weight:600; }
.gt td { padding:10px 12px; border:1px solid #3a3f48; vertical-align:top; }
.gt tbody tr:nth-child(odd)  { background:#1a1d23; }
.gt tbody tr:nth-child(even) { background:#22262d; }
