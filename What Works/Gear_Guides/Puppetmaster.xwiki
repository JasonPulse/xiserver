= 🦾 Frame Choices =

{{html clean="false"}}
<table class="gt">
<thead><tr><th style="width:140px;">Lv</th><th>Frame Pick</th><th>Notes</th></tr></thead>
<tbody>
<tr><td class="lv">10</td><td><strong>Sharpshot</strong> (party) or <strong>Stormwaker</strong> (solo)</td><td>First frame upgrade — Sharpshot ranges in pulls, Stormwaker self-heals/nukes for solo</td></tr>
<tr><td class="lv">40</td><td><strong>Soulsoother</strong></td><td>Healer head — best general pick for endgame parties</td></tr>
<tr><td class="lv">50</td><td><strong>Soulsoother</strong> or <strong>Spiritreaver</strong></td><td>Last head choice. Soulsoother for parties, Spiritreaver for nuke/burn parties</td></tr>
</tbody>
</table>
{{/html}}

