<tr><td class="lv">71</td><td><a href="https://www.bg-wiki.com/ffxi/Angel_Lyre">Angel Lyre</a></td><td>Haste +2% · Hymnus +2</td></tr>
<tr><td class="lv">75</td><td><a href="https://www.bg-wiki.com/ffxi/Cythara_Anglica_+1">Cythara Anglica +1</a></td><td>CHR +3 · Virelai +2</td></tr>
